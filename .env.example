# Server-side OpenAI-compatible model configuration (never expose to frontend)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
# Set actual weights on the server; never distribute weights without permission.
BASKETBALL_MODEL_PATH=E:/basketball-highlight-editor/models/bball_model.pt
# Original editor source checkout; its detection code is invoked unchanged.
# Defaults to this repository's vendor/basketball-highlight-editor.
# BASKETBALL_ENGINE_ROOT=E:/basketball-highlight-editor
# Optional Python with original editor dependencies (defaults to server Python).
# BASKETBALL_ENGINE_PYTHON=E:/python/python.exe

# API and worker must use the same absolute directory (not automatically loaded).
BASKETBALL_DATA_DIR=E:/basketball-data
